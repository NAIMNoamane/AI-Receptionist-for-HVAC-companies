    {
      "parameters": {
        "jsCode": "const raw = $json.query;\nlet p = {};\n\nif (raw && typeof raw === 'object') {\n  p = raw;\n} else {\n  const text = String(raw ?? '').trim();\n  try {\n    p = JSON.parse(text);\n  } catch {\n    for (const m of text.matchAll(/(\\w+)\\s*:\\s*([^,]+)/g)) {\n      p[m[1]] = m[2].trim();\n    }\n  }\n}\n\nconst required = ['afterTime', 'beforeTime'];\nconst missing = required.filter(k => !p[k] || String(p[k]).trim() === '');\nif (missing.length) throw new Error('MISSING_FIELDS: ' + missing.join(','));\n\nconst after = new Date(p.afterTime);\nconst before = new Date(p.beforeTime);\nif (isNaN(after) || isNaN(before)) throw new Error('INVALID_DATE: afterTime/beforeTime must be ISO dates');\nif (before <= after) throw new Error('INVALID_RANGE: beforeTime must be later than afterTime');\n\nreturn [{ json: { ...p, ok: true } }];"
      },
