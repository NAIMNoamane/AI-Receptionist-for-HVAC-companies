      "parameters": {
        "jsCode": "const email=String($('Validate Input').first().json.email||'').toLowerCase();const rows=$input.all().map(x=>x.json).filter(r=>String(r.Email||'').toLowerCase()===email && !/cancel/i.test(String(r.Status||'')));return [{json:{ok:true,appointments:rows.map(r=>({id:r['Appointment ID'],eventID:r['Calendar Event ID'],startTime:r['Start ISO'],status:r.Status})).slice(0,10)}}];"
