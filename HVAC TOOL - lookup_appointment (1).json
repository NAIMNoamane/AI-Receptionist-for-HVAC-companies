    {
      "parameters": {
        "jsCode": "const v=$input.first().json; const a=v.body && typeof v.body==='object'?v.body:v; return [{json:{...a, _source:v.body?'webhook':'mcp'}}];"
      },
      "id": "32c38ca8-3322-47cc-94e1-f758811dc3c9",
      "name": "Normalize Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nlet q = raw.query;\n\nlet p;\nif (q && typeof q === \"object\") {\n  // already an object\n  p = q;\n} else if (typeof q === \"string\") {\n  const s = q.trim();\n  if (s.startsWith(\"{\")) {\n    // JSON string\n    try {\n      p = JSON.parse(s);\n    } catch (e) {\n      throw new Error(\"INVALID_JSON: \" + e.message);\n    }\n  } else {\n    // plain string, treat it as the email\n    p = { email: s };\n  }\n} else {\n  p = raw;\n}\n\nconst required = [\"email\"];\nconst missing = required.filter(k => p[k] === undefined || p[k] === null || String(p[k]).trim() === \"\");\nif (missing.length) throw new Error(\"MISSING_FIELDS: \" + missing.join(\",\"));\n\n// basic email format check\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(String(p.email).trim())) throw new Error(\"INVALID_EMAIL\");\n\nreturn [{ json: { ...p, email: String(p.email).trim(), ok: true } }];"
      },
