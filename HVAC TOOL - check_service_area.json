      "parameters": {
        "jsCode": "const allowedZip = [\n  \"85004\",\"85008\",\"85016\",\"85018\",\"85020\",\"85022\",\"85032\",\"85044\",\n  \"85048\",\"85224\",\"85225\",\"85226\",\"85233\",\"85234\",\"85254\",\"85301\"\n];\n\nconst raw = String($input.first().json.query ?? \"\");\nconst match = raw.match(/\\b\\d{5}\\b/);   // grabs the first 5-digit ZIP\nconst zipCode = match ? match[0] : \"\";\n\nconsole.log(\"raw:\", raw, \"| zip:\", zipCode);\n\nconst status = allowedZip.includes(zipCode) ? \"Allowed Area\" : \"Not Allowed Area\";\nreturn [{ json: { status, zip: zipCode } }];"
