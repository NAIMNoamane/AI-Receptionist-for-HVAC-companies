      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\n\nlet p;\ntry {\n  p = typeof raw.query === \"string\" ? JSON.parse(raw.query) : (raw.query ?? raw);\n} catch (e) {\n  throw new Error(\"INVALID_JSON: could not parse query - \" + e.message);\n}\n\nconst required = [\"startTime\", \"endTime\", \"email\", \"serviceType\", \"zipCode\"];\nconst missing = required.filter(k => p[k] === undefined || p[k] === null || String(p[k]).trim() === \"\");\n\nif (missing.length) throw new Error(\"MISSING_FIELDS: \" + missing.join(\",\"));\n\nreturn [{ json: { ...p, ok: true } }];"
      },
      "id": "11117abb-dfdf-436d-aee5-94417ac904b4",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\n\nconst allowed = [\"85004\", \"85008\", \"85016\", \"85018\", \"85020\", \"85022\", \"85032\", \"85044\", \"85048\", \"85224\", \"85225\", \"85226\", \"85233\", \"85234\", \"85254\", \"85301\"];\n\nif (!allowed.includes(String(p.zipCode).trim())) throw new Error(\"OUTSIDE_AREA\");\n\nconst st = Date.parse(p.startTime);\nconst en = Date.parse(p.endTime);\nif (isNaN(st) || isNaN(en) || en <= st || en - st > 2 * 60 * 60 * 1000) throw new Error(\"INVALID_TIME\");\n\nconst phone = p.Phone || p.phone || p.phoneNumber || \"N/A\";\n\nreturn [{\n  json: {\n    ...p,\n    eventSummary: \"DEMO HVAC: \" + p.serviceType,\n    description: \"Requested by \" + p.email + \" | \" + phone + \" | demo only\"\n  }\n}];"
      },
