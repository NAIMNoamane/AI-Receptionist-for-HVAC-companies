    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.query;\n\n// Normalize keys so \"Caller Phone\", \"caller_phone\" and \"callerPhone\" all match\nconst norm = (s) => String(s).toLowerCase().replace(/[^a-z0-9]/g, \"\");\nconst clean = (v) => (v === undefined || v === null ? \"\" : String(v).trim());\n\nlet data = {};\n\nif (raw && typeof raw === \"object\") {\n  data = raw;\n} else if (typeof raw === \"string\") {\n  try {\n    data = JSON.parse(raw);\n  } catch (e) {\n    // Fallback: parse labeled text. Summary may contain commas, so each\n    // value stops only at the next known label or at the end of the text.\n    const labels = \"Caller Phone|Customer ID|Summary\";\n    const grab = (label) => {\n      const re = new RegExp(\n        `${label}\\\\s*[:=\\\\-]\\\\s*([\\\\s\\\\S]*?)(?=[,;\\\\n]\\\\s*(?:${labels})\\\\s*[:=\\\\-]|$)`,\n        \"i\"\n      );\n      const m = raw.match(re);\n      return m ? m[1].trim() : \"\";\n    };\n    data = {\n      \"Caller Phone\": grab(\"Caller Phone\"),\n      \"Customer ID\": grab(\"Customer ID\"),\n      \"Summary\": grab(\"Summary\"),\n    };\n  }\n}\n\n// Build a lookup with normalized keys\nconst lookup = {};\nfor (const [k, v] of Object.entries(data)) lookup[norm(k)] = v;\n\n// Auto-generated unique Call ID, e.g. CALL-1763000000000-K4F9\nconst callId = `CALL-${Date.now()}-${Math.random().toString(36).slice(2, 6).toUpperCase()}`;\n\nreturn [\n  {\n    json: {\n      \"Call ID\": callId,\n      \"Caller Phone\": clean(lookup[\"callerphone\"] ?? lookup[\"phone\"]),\n      \"Customer ID\": clean(lookup[\"customerid\"]),\n      \"Summary\": clean(lookup[\"summary\"]),\n    },\n  },\n];"
      },
